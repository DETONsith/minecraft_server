# ==============================================================================
# MINECRAFT SERVER TEMPLATE - CONFIGURAÇÃO GERAL
# ==============================================================================

# Caminho raiz da instalação (deixe vazio para autodetectar diretório atual)
SERVER_ROOT_DIR=

# Modo de Operação: standalone (Execução direta recomendada para Modpacks) ou crafty (Painel Web)
SERVER_MODE=standalone

# Alocação de Memória RAM (Otimizado para Codespace 8GB: 3G a 4.5G)
MIN_RAM=3G
MAX_RAM=4500M

# Comando ou Caminho do Java 8 (deixe vazio para autodetectar Java 8 do sistema)
JAVA_8_BIN=

# Configuração de Autenticação (false permite SKLauncher / contas offline)
ONLINE_MODE=false

# Configuração de Portas
MINECRAFT_PORT=25565
CRAFTY_PORT=8443

# Tunelamento e Acesso Externo (Playit.gg)
ENABLE_PLAYIT=true
PLAYIT_SOCKET_DIR=/tmp/playit

# Configuração de Backups e Nuvem (rclone)
BACKUP_DIR=backups
RCLONE_REMOTE=drive:Minecraft_Backups
BACKUP_RETENTION_LOCAL=3
BACKUP_RETENTION_CLOUD=7

# Configuração de Codespace / Agendamento Automático (Opcional)
CODESPACE_NAME=

# Desligamento Automático por Inatividade (Idle Auto-Shutdown)
IDLE_SHUTDOWN_ENABLED=true
IDLE_TIMEOUT_MINUTES=10
